# Optionnel : URL publique du site (canonical, hreflang, Open Graph).
# Sur Vercel, le domaine de production est détecté automatiquement.
NEXT_PUBLIC_SITE_URL=

# Destination des demandes de rappel (POST JSON).
# Exemple : un Google Apps Script relié à une Google Sheet (voir README), un webhook n8n ou Make.
LEADS_WEBHOOK_URL=

# Optionnel : secret envoyé dans l'en-tête X-Webhook-Secret pour authentifier l'appel.
LEADS_WEBHOOK_SECRET=

# Optionnel : mesure d'audience (rien n'est chargé si vide)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
